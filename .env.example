# Chave pública do navegador: restrinja por sites/referenciadores HTTP e Maps JavaScript API.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Chave privada do servidor: Places API (New) e Geocoding API; restrinja o IP de saída quando possível.
# Não use o prefixo NEXT_PUBLIC nesta chave. Não versione .env.local.
GOOGLE_MAPS_SERVER_API_KEY=
